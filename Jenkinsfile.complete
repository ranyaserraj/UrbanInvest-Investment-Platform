pipeline {
    agent any

    environment {
        // Variables d'environnement pour Docker
        DOCKER_IMAGE = 'urbaninvest/urbaninvest-platform'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKER_REGISTRY = 'docker.io'
        
        // Variables pour SonarQube
        SONAR_PROJECT_KEY = 'urbaninvest-platform'
        SONAR_PROJECT_NAME = 'UrbanInvest Platform'
        SONAR_HOST_URL = 'http://sonarqube:9000'
        
        // Variables pour Kubernetes
        K8S_NAMESPACE = 'urbaninvest'
        APP_NAME = 'urbaninvest-app'
    }

    stages {
        // ========================================
        // ÉTAPE 1: CHECKOUT - Cloner le repository
        // ========================================
        stage('1. Checkout') {
            steps {
                echo '🔄 Clonage du repository GitHub...'
                checkout scm
                script {
                    def gitCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    def gitBranch = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()
                    echo "📋 Commit: ${gitCommit}"
                    echo "🌿 Branche: ${gitBranch}"
                }
            }
        }

        // ========================================
        // ÉTAPE 2: BUILD - Compiler le projet
        // ========================================
        stage('2. Build') {
            steps {
                echo '🔨 Compilation du projet Maven...'
                script {
                    if (fileExists('mvnw')) {
                        sh './mvnw clean compile'
                    } else {
                        sh 'mvn clean compile'
                    }
                }
            }
        }

        // ========================================
        // ÉTAPE 3: TEST - Tests unitaires
        // ========================================
        stage('3. Test') {
            steps {
                echo '🧪 Exécution des tests unitaires...'
                script {
                    if (fileExists('mvnw')) {
                        sh './mvnw test'
                    } else {
                        sh 'mvn test'
                    }
                }
            }
            post {
                always {
                    // Publication des rapports de tests
                    junit 'target/surefire-reports/**/*.xml'
                    // Rapport de couverture JaCoCo
                    jacoco(execPattern: 'target/jacoco.exec', classPattern: '**/classes', sourcePattern: '**/src/main/java')
                }
            }
        }

        // ========================================
        // ÉTAPE 4: PACKAGE - Générer le WAR
        // ========================================
        stage('4. Package') {
            steps {
                echo '📦 Génération du package WAR...'
                script {
                    if (fileExists('mvnw')) {
                        sh './mvnw package -DskipTests'
                    } else {
                        sh 'mvn package -DskipTests'
                    }
                }
            }
            post {
                always {
                    // Archivage des artefacts
                    archiveArtifacts artifacts: 'target/*.war', fingerprint: true
                }
            }
        }

        // ========================================
        // ÉTAPE 5: SONARQUBE - Analyse qualité
        // ========================================
        stage('5. SonarQube Analysis') {
            steps {
                echo '🔍 Analyse de la qualité du code avec SonarQube...'
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    script {
                        if (fileExists('mvnw')) {
                            sh "./mvnw sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY} -Dsonar.projectName='${SONAR_PROJECT_NAME}' -Dsonar.host.url=${SONAR_HOST_URL} -Dsonar.token=${SONAR_TOKEN}"
                        } else {
                            sh "mvn sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY} -Dsonar.projectName='${SONAR_PROJECT_NAME}' -Dsonar.host.url=${SONAR_HOST_URL} -Dsonar.token=${SONAR_TOKEN}"
                        }
                    }
                }
            }
        }

        // ========================================
        // ÉTAPE 6: DOCKER - Containerisation
        // ========================================
        stage('6. Docker Build & Push') {
            steps {
                echo '🐳 Construction et publication de l\'image Docker...'
                script {
                    // Construction de l'image
                    sh "docker build -f Dockerfile.webapp -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                    sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
                    
                    // Publication sur Docker Hub (optionnel)
                    // withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    //     sh "echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin"
                    //     sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    //     sh "docker push ${DOCKER_IMAGE}:latest"
                    // }
                }
            }
        }

        // ========================================
        // ÉTAPE 7: KUBERNETES - Déploiement
        // ========================================
        stage('7. Kubernetes Deployment') {
            steps {
                echo '☸️ Déploiement sur Kubernetes...'
                script {
                    // Création du namespace
                    sh "kubectl create namespace ${K8S_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -"
                    
                    // Déploiement de l'application
                    sh "kubectl apply -f k8s/ -n ${K8S_NAMESPACE}"
                    
                    // Attente du déploiement
                    sh "kubectl rollout status deployment/${APP_NAME} -n ${K8S_NAMESPACE} --timeout=300s"
                }
            }
        }

        // ========================================
        // ÉTAPE 8: MONITORING - Prometheus & Grafana
        // ========================================
        stage('8. Monitoring Setup') {
            steps {
                echo '📊 Configuration du monitoring avec Prometheus & Grafana...'
                script {
                    // Déploiement de Prometheus
                    sh "kubectl apply -f monitoring/prometheus/ -n ${K8S_NAMESPACE}"
                    
                    // Déploiement de Grafana
                    sh "kubectl apply -f monitoring/grafana/ -n ${K8S_NAMESPACE}"
                    
                    // Attente du démarrage des services
                    sh "kubectl wait --for=condition=available --timeout=300s deployment/prometheus -n ${K8S_NAMESPACE}"
                    sh "kubectl wait --for=condition=available --timeout=300s deployment/grafana -n ${K8S_NAMESPACE}"
                }
            }
        }

        // ========================================
        // ÉTAPE 9: HEALTH CHECK - Vérification
        // ========================================
        stage('9. Health Check') {
            steps {
                echo '🏥 Vérification de la santé de l\'application...'
                script {
                    // Vérification des pods
                    sh "kubectl get pods -n ${K8S_NAMESPACE}"
                    
                    // Vérification des services
                    sh "kubectl get services -n ${K8S_NAMESPACE}"
                    
                    // Test de connectivité
                    sh "kubectl port-forward service/${APP_NAME} 8080:8080 -n ${K8S_NAMESPACE} &"
                    sleep(10)
                    sh "curl -f http://localhost:8080/ || exit 1"
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline exécuté avec succès !'
            echo '🌐 Application déployée et accessible'
            echo '📊 Monitoring configuré'
            
            // Notification de succès
            script {
                def deploymentUrl = "http://localhost:8080"
                def grafanaUrl = "http://localhost:3000"
                def prometheusUrl = "http://localhost:9090"
                
                echo "🔗 URLs d'accès :"
                echo "   Application: ${deploymentUrl}"
                echo "   Grafana: ${grafanaUrl}"
                echo "   Prometheus: ${prometheusUrl}"
            }
        }
        failure {
            echo '❌ Pipeline échoué !'
            echo '🧹 Nettoyage des ressources...'
            
            // Nettoyage en cas d'échec
            script {
                sh "kubectl delete namespace ${K8S_NAMESPACE} --ignore-not-found=true"
            }
        }
        always {
            echo '📋 Nettoyage des ressources temporaires...'
            // Nettoyage des conteneurs temporaires
            sh "docker system prune -f"
        }
    }
}
