<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
<servlet>
        <servlet-name>form1</servlet-name>
        <servlet-class>projet_s3.form1</servlet-class>
</servlet>
<servlet-mapping>
        <servlet-name>form1</servlet-name>
        <url-pattern>/form1</url-pattern>
</servlet-mapping>

<servlet>
        <servlet-name>form2</servlet-name>
        <servlet-class>projet_s3.form2</servlet-class>
</servlet>
<servlet-mapping>
        <servlet-name>form2</servlet-name>
        <url-pattern>/form2</url-pattern>
</servlet-mapping>


<servlet>
        <servlet-name>RegistrationServlet</servlet-name>
        <servlet-class>projet_s3.RegistrationServlet</servlet-class>
</servlet>
<servlet-mapping>
        <servlet-name>RegistrationServlet</servlet-name>
        <url-pattern>/register1</url-pattern>
</servlet-mapping>

   
<servlet>
        <servlet-name>Login</servlet-name>
        <servlet-class>projet_s3.Login</servlet-class>
</servlet>
<servlet-mapping>
        <servlet-name>Login</servlet-name>
        <url-pattern>/login1</url-pattern>
</servlet-mapping>

</web-app>